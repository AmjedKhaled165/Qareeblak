# =====================================================================
# QAREABLAK PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env in backend (server/) and .env.local in frontend (src/)
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# ---------------------------------------------------------------------
# 2. JWT SECURITY KEYS (Generate strong random secrets in production)
# ---------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_change_in_production_123!
JWT_ACCESS_SECRET=super_secret_access_jwt_key_123!
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_456!

# ---------------------------------------------------------------------
# 3. DATABASE & REDIS
# ---------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/qareeblak_db
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------
# 4. EMAIL / SMTP CONFIGURATION (GMAIL / ZOHO / CUSTOM)
# For Gmail: Enable 2-Step Verification & generate 16-char App Password
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Qareeblak | قريبلك" <your-account@gmail.com>

# ---------------------------------------------------------------------
# 5. FIREBASE CLIENT CONFIGURATION (FRONTEND - src/.env.local)
# Get from Firebase Console -> Project Settings -> General -> Web App
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=qareeblak-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=qareeblak-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=qareeblak-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ---------------------------------------------------------------------
# 6. FIREBASE ADMIN SDK (BACKEND - server/.env)
# Option A: Provide Base64-encoded Service Account JSON
# FIREBASE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiw...
#
# Option B: Individual Service Account fields
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=qareeblak-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@qareeblak-app.iam.gserviceaccount.com
# Use FIREBASE_PRIVATE_KEY_BASE64 for clean single-line configuration
FIREBASE_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0t...
